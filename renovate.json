{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits"
  ],
  "timezone": "Europe/Prague",
  "labels": [
    "dependencies"
  ],
  "minimumReleaseAge": "7 days",
  "internalChecksFilter": "strict",
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "automergeType": "pr",
  "platformAutomerge": false,
  "automergeSchedule": [
    "* 2 * * 6"
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "* 2 * * 6"
    ],
    "automerge": false
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": [
      "dependencies",
      "security"
    ],
    "minimumReleaseAge": null
  },
  "packageRules": [
    {
      "description": "Patch, pin a digest updaty: automerge po zeleném CI v okně údržby (sobota 02:00–03:00 Praha).",
      "matchUpdateTypes": [
        "patch",
        "pin",
        "digest"
      ],
      "automerge": true
    },
    {
      "description": "Minor: PR k review (orchestrátor / operátor).",
      "matchUpdateTypes": [
        "minor"
      ],
      "automerge": false
    },
    {
      "description": "Major: běžný PR k review (repo nemá issues, Dependency Dashboard nelze vytvořit).",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    },
    {
      "description": "GitHub Actions pinovat na digest (supply-chain).",
      "matchManagers": [
        "github-actions"
      ],
      "pinDigests": true
    },
    {
      "description": "Fork bez běžícího CI: žádný automerge, všechny updaty jen jako PR k review (dokud se nepovolí GitHub Actions ve forku).",
      "matchPackageNames": [
        "*"
      ],
      "automerge": false
    }
  ],
  "dependencyDashboard": false
}
